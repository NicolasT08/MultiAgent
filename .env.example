# Copy to .env (never commit it). Read by src/formal_mas/llm/client.py at run time.
# Which variable each provider uses is set in config/models.yaml → providers.*.api_key_env.

# Profile `experiment` (paid, DeepSeek API)
DEEPSEEK_API_KEY=
# Profile `dev` (Gemini free tier)
GEMINI_API_KEY=
# Phase 9 (Hugging Face Hub)
HF_TOKEN=

# Optional: profile to use (default: models.yaml → default_profile)
# MODEL_PROFILE=dev
